config videoplayer 'main'
	option enabled '1'
	# Existing directory that contains media files. It is not created automatically.
	# Use mounted USB/SD storage; copying video to an unmounted /mnt path fills overlay.
	option media_path '/mnt/video'
	# Allow playback of remote HTTP(S) URLs in the browser player
	option allow_remote '1'
	# Local playback mode: browser or router
	option render_mode 'browser'
	# Router CPU renderer FPS: 5, 8, 12, 15, 20, 24, 30, 48, 50, or 60
	option router_fps '8'
	# CPU renderer preset: fast favors throughput on low-end routers; quality keeps 640x360
	option router_profile 'fast'
	# Opt in to maximum supported decode/filter/MJPEG work at normal scheduler priority
	option router_max_threads '0'
	# Max depth when browsing local folders
	option max_depth '8'
