#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
#
# Token-authenticated CGI media streamer with HTTP Range support.

export PATH="/usr/sbin:/usr/bin:/sbin:/bin"
export LC_ALL=C

VIDEO_EXTS="3g2 3gp 264 265 asf avi divx f4v flv h264 h265 hevc m2ts m2v m4v mkv mov mp4 mpe mpeg mpg mts ogg ogv rm rmvb ts vob webm wmv"
TOKEN_DIR="/tmp/videoplayer-tokens"
TOKEN_LAYOUT_MARKER="$TOKEN_DIR/.bucket-v1"
TOKEN_BUCKET_HEX=3
RENDERER_HELPER="/usr/libexec/videoplayer-renderer"
MAX_PATH_LENGTH=4096
MAX_RANGE_DIGITS=18

string_has_control() {
	printf '%s' "$1" | grep -q '[[:cntrl:]]'
}

path_has_dotdot_component() {
	case "$1" in
		../*|*/../*|*/..) return 0 ;;
	esac
	return 1
}

get_configured_media_path() {
	local path

	path="$(uci -q get videoplayer.main.media_path 2>/dev/null)" || path=""
	[ -n "$path" ] || path="/mnt/video"
	printf '%s\n' "$path"
}

canonicalize_media_root() {
	local configured="$1" root

	[ -n "$configured" ] || return 1
	[ "${#configured}" -le "$MAX_PATH_LENGTH" ] || return 1
	string_has_control "$configured" && return 1

	case "$configured" in
		/*) ;;
		*) return 1 ;;
	esac
	path_has_dotdot_component "$configured" && return 1

	[ -d "$configured" ] || return 1
	root="$(readlink -f -- "$configured" 2>/dev/null)" || return 1
	[ -n "$root" ] && [ -d "$root" ] || return 1
	string_has_control "$root" && return 1
	[ "$root" != "/" ] || return 1

	printf '%s\n' "$root"
}

get_media_root() {
	local configured

	configured="$(get_configured_media_path)"
	canonicalize_media_root "$configured"
}

path_is_within_root() {
	local root="$1" path="$2"

	case "$path" in
		"$root"|"$root"/*) return 0 ;;
		*) return 1 ;;
	esac
}

get_enabled() {
	local value

	value="$(uci -q get videoplayer.main.enabled 2>/dev/null)" || value=""
	[ -n "$value" ] || value="1"

	case "$value" in
		1) printf '1\n' ;;
		*) printf '0\n' ;;
	esac
}

get_render_mode() {
	local value

	value="$(uci -q get videoplayer.main.render_mode 2>/dev/null)" || value=""
	case "$value" in
		router) printf 'router\n' ;;
		*) printf 'browser\n' ;;
	esac
}

is_allowed_ext() {
	local name="$1" base ext

	base="${name##*/}"
	case "$base" in
		*.*) ;;
		*) return 1 ;;
	esac
	ext="$(printf '%s' "${base##*.}" |
		tr 'ABCDEFGHIJKLMNOPQRSTUVWXYZ' 'abcdefghijklmnopqrstuvwxyz')"
	case " $VIDEO_EXTS " in
		*" $ext "*) return 0 ;;
		*) return 1 ;;
	esac
}

mime_for() {
	local name="$1" base ext

	base="${name##*/}"
	ext="$(printf '%s' "${base##*.}" |
		tr 'ABCDEFGHIJKLMNOPQRSTUVWXYZ' 'abcdefghijklmnopqrstuvwxyz')"
	case "$ext" in
		mp4|m4v|f4v) printf 'video/mp4\n' ;;
		webm) printf 'video/webm\n' ;;
		ogg|ogv) printf 'video/ogg\n' ;;
		mov) printf 'video/quicktime\n' ;;
		mkv) printf 'video/x-matroska\n' ;;
		avi|divx) printf 'video/x-msvideo\n' ;;
		mpg|mpeg|mpe|m2v|vob) printf 'video/mpeg\n' ;;
		ts|m2ts|mts) printf 'video/mp2t\n' ;;
		flv) printf 'video/x-flv\n' ;;
		wmv) printf 'video/x-ms-wmv\n' ;;
		asf) printf 'video/x-ms-asf\n' ;;
		3gp) printf 'video/3gpp\n' ;;
		3g2) printf 'video/3gpp2\n' ;;
		h264|264) printf 'video/h264\n' ;;
		h265|265|hevc) printf 'video/h265\n' ;;
		rm|rmvb) printf 'application/vnd.rn-realmedia\n' ;;
		*) printf 'application/octet-stream\n' ;;
	esac
}

valid_token() {
	local token="$1"

	[ "${#token}" -eq 32 ] || return 1
	case "$token" in
		*[!0-9a-f]*) return 1 ;;
	esac
	return 0
}

token_dir_is_safe() {
	local canonical metadata layout

	[ -d "$TOKEN_DIR" ] && [ ! -L "$TOKEN_DIR" ] || return 1
	canonical="$(readlink -f -- "$TOKEN_DIR" 2>/dev/null)" || return 1
	[ "$canonical" = "$TOKEN_DIR" ] || return 1
	metadata="$(stat -c '%u:%a' -- "$TOKEN_DIR" 2>/dev/null)" || return 1
	[ "$metadata" = "0:700" ] || return 1
	[ -f "$TOKEN_LAYOUT_MARKER" ] && [ ! -L "$TOKEN_LAYOUT_MARKER" ] || return 1
	IFS= read -r layout < "$TOKEN_LAYOUT_MARKER" || return 1
	[ "$layout" = "bucket-v1" ] || return 1
	return 0
}

load_token() {
	local token="$1" bucket token_file stored_token now extra

	TOKEN_EXPIRY=""
	TOKEN_PATH=""
	valid_token "$token" || return 1
	token_dir_is_safe || return 1
	bucket="$(printf '%.3s' "$token")"
	[ "${#bucket}" -eq "$TOKEN_BUCKET_HEX" ] || return 1
	token_file="$TOKEN_DIR/t-$bucket"
	[ -f "$token_file" ] && [ ! -L "$token_file" ] || return 1

	exec 8< "$token_file" || return 1
	IFS= read -r stored_token <&8 || {
		exec 8<&-
		return 1
	}
	IFS= read -r TOKEN_EXPIRY <&8 || {
		exec 8<&-
		return 1
	}
	IFS= read -r TOKEN_PATH <&8 || {
		exec 8<&-
		return 1
	}
	if IFS= read -r extra <&8; then
		: "$extra"
		exec 8<&-
		return 1
	fi
	exec 8<&-

	[ "$stored_token" = "$token" ] || return 1
	case "$TOKEN_EXPIRY" in
		''|*[!0-9]*) return 1 ;;
	esac
	[ "${#TOKEN_EXPIRY}" -le 12 ] || return 1
	[ -n "$TOKEN_PATH" ] && [ "${#TOKEN_PATH}" -le "$MAX_PATH_LENGTH" ] || return 1
	string_has_control "$TOKEN_PATH" && return 1
	case "$TOKEN_PATH" in
		/*) ;;
		*) return 1 ;;
	esac

	now="$(date +%s 2>/dev/null)" || return 1
	case "$now" in
		''|*[!0-9]*) return 1 ;;
	esac
	if [ "$TOKEN_EXPIRY" -le "$now" ]; then
		return 1
	fi

	return 0
}

http_err() {
	local status="$1" message="$2"

	printf 'Status: %s\r\n' "$status"
	printf 'Content-Type: text/plain; charset=utf-8\r\n'
	printf 'Cache-Control: no-store\r\n'
	printf 'X-Content-Type-Options: nosniff\r\n'
	printf '\r\n'
	if [ "${REQUEST_METHOD:-GET}" != "HEAD" ]; then
		printf '%s\n' "$message"
	fi
	exit 0
}

method_err() {
	printf 'Status: 405 Method Not Allowed\r\n'
	printf 'Allow: GET, HEAD\r\n'
	printf 'Content-Type: text/plain; charset=utf-8\r\n'
	printf 'Cache-Control: no-store\r\n'
	printf '\r\n'
	if [ "${REQUEST_METHOD:-GET}" != "HEAD" ]; then
		printf 'Method not allowed\n'
	fi
	exit 0
}

range_err() {
	local size="$1"

	printf 'Status: 416 Range Not Satisfiable\r\n'
	printf 'Content-Range: bytes */%s\r\n' "$size"
	printf 'Content-Type: text/plain; charset=utf-8\r\n'
	printf 'Cache-Control: no-store\r\n'
	printf '\r\n'
	if [ "${REQUEST_METHOD:-GET}" != "HEAD" ]; then
		printf 'Invalid range\n'
	fi
	exit 0
}

normalize_decimal() {
	local value="$1"

	case "$value" in
		''|*[!0-9]*) return 1 ;;
	esac
	[ "${#value}" -le "$MAX_RANGE_DIGITS" ] || return 1

	while [ "${#value}" -gt 1 ] && [ "${value#0}" != "$value" ]; do
		value="${value#0}"
	done

	printf '%s\n' "$value"
}

# Sets RANGE_START, RANGE_END and RANGE_STATUS.
parse_range() {
	local header="$1" size="$2" spec left right suffix

	RANGE_START=0
	RANGE_END=$((size - 1))
	RANGE_STATUS="200 OK"

	[ -n "$header" ] || return 0
	case "$header" in
		bytes=*) spec="${header#bytes=}" ;;
		*) return 1 ;;
	esac

	case "$spec" in
		''|*[!0-9-]*|*,*) return 1 ;;
	esac

	left="${spec%%-*}"
	right="${spec#*-}"
	[ "$right" != "$spec" ] || return 1
	case "$right" in
		*-*) return 1 ;;
	esac
	[ -n "$left" ] || [ -n "$right" ] || return 1

	if [ -z "$left" ]; then
		suffix="$(normalize_decimal "$right")" || return 1
		[ "$suffix" -gt 0 ] || return 1
		if [ "$suffix" -ge "$size" ]; then
			RANGE_START=0
		else
			RANGE_START=$((size - suffix))
		fi
	else
		RANGE_START="$(normalize_decimal "$left")" || return 1
		[ "$RANGE_START" -lt "$size" ] || return 1

		if [ -n "$right" ]; then
			RANGE_END="$(normalize_decimal "$right")" || return 1
			[ "$RANGE_START" -le "$RANGE_END" ] || return 1
			if [ "$RANGE_END" -ge "$size" ]; then
				RANGE_END=$((size - 1))
			fi
		fi
	fi

	RANGE_STATUS="206 Partial Content"
	return 0
}

send_range() {
	local start="$1" length="$2"

	if [ "$DD_BYTE_FLAGS" -eq 1 ]; then
		dd bs=65536 iflag=skip_bytes,count_bytes skip="$start" count="$length" <&3 2>/dev/null
	else
		tail -c "+$((start + 1))" <&3 2>/dev/null | head -c "$length" 2>/dev/null
	fi
}

# --- main ---

REQUEST_METHOD="${REQUEST_METHOD:-GET}"
case "$REQUEST_METHOD" in
	GET|HEAD) ;;
	*) method_err ;;
esac

[ "$(get_enabled)" = "1" ] || http_err "403 Forbidden" "Video player disabled"

token=""
renderer=""
audio=""
query="${QUERY_STRING:-}"
case "$query" in
	token=*)
		case "$query" in
			*'&'*) http_err "400 Bad Request" "Invalid stream query" ;;
		esac
		token="${query#token=}"
		;;
	renderer=*\&audio=*)
		first="${query%%&*}"
		second="${query#*&}"
		case "$second" in
			audio=*) ;;
			*) http_err "400 Bad Request" "Invalid stream query" ;;
		esac
		case "$second" in
			*'&'*) http_err "400 Bad Request" "Invalid stream query" ;;
		esac
		renderer="${first#renderer=}"
		audio="${second#audio=}"
		;;
	*) http_err "400 Bad Request" "Invalid stream query" ;;
esac

root="$(get_media_root 2>/dev/null)" ||
	http_err "503 Service Unavailable" "Media path is invalid or inaccessible"

renderer_bound=0
if [ -n "$token" ]; then
	valid_token "$token" ||
		http_err "403 Forbidden" "Invalid or expired stream token"
	load_token "$token" ||
		http_err "403 Forbidden" "Invalid or expired stream token"
	[ -f "$TOKEN_PATH" ] || http_err "404 Not Found" "Media file is missing"
	canonical="$(readlink -f -- "$TOKEN_PATH" 2>/dev/null)" ||
		http_err "403 Forbidden" "Invalid media path"
	[ "$canonical" = "$TOKEN_PATH" ] ||
		http_err "403 Forbidden" "Media path changed"
	path_is_within_root "$root" "$canonical" ||
		http_err "403 Forbidden" "Media path is outside the configured root"
	is_allowed_ext "$canonical" ||
		http_err "415 Unsupported Media Type" "Unsupported file type"

	# Keep the validated file open for the whole response. Re-check the opened
	# descriptor to close the readlink/open race before sending any bytes.
	exec 3< "$canonical" || http_err "404 Not Found" "Media file is missing"
else
	valid_token "$renderer" ||
		http_err "403 Forbidden" "Invalid or inactive renderer capability"
	valid_token "$audio" ||
		http_err "403 Forbidden" "Invalid browser-audio capability"
	[ "$(get_render_mode 2>/dev/null)" = "router" ] ||
		http_err "409 Conflict" "Router CPU rendering is not selected"
	[ -x "$RENDERER_HELPER" ] ||
		http_err "503 Service Unavailable" "Router CPU renderer is unavailable"
	source_info="$(
		"$RENDERER_HELPER" source-info "$renderer" "$audio" \
			3<&- 2>/dev/null
	)" || http_err "403 Forbidden" "Invalid or inactive audio capability"
	old_ifs="$IFS"
	IFS="$(printf '\t')"
	set -f
	# Intentional split on the helper's tab-separated, control-free record.
	# shellcheck disable=SC2086
	set -- $source_info
	set +f
	IFS="$old_ifs"
	[ "$#" -eq 3 ] ||
		http_err "403 Forbidden" "Invalid renderer source metadata"
	canonical="$1"
	source_fd="$2"
	source_identity="$3"
	if [ -z "$canonical" ] ||
	   [ "${#canonical}" -gt "$MAX_PATH_LENGTH" ]; then
		http_err "403 Forbidden" "Invalid renderer source"
	fi
	string_has_control "$canonical" &&
		http_err "403 Forbidden" "Invalid renderer source"
	case "$canonical" in
		/*) ;;
		*) http_err "403 Forbidden" "Invalid renderer source" ;;
	esac
	path_is_within_root "$root" "$canonical" ||
		http_err "403 Forbidden" "Renderer source is outside the configured root"
	case "$source_fd" in
		/proc/*/fd/3)
			source_pid="${source_fd#/proc/}"
			source_pid="${source_pid%/fd/3}"
			;;
		*) http_err "403 Forbidden" "Invalid renderer source descriptor" ;;
	esac
	case "$source_pid" in
		''|*[!0-9]*)
			http_err "403 Forbidden" "Invalid renderer source descriptor"
			;;
	esac
	if [ "${#source_pid}" -gt 10 ] || [ "$source_pid" -le 1 ]; then
		http_err "403 Forbidden" "Invalid renderer source descriptor"
	fi
	identity_device="${source_identity%%:*}"
	identity_tail="${source_identity#*:}"
	identity_inode="${identity_tail%%:*}"
	identity_size="${identity_tail#*:}"
	case "$identity_size" in
		*:*|'') http_err "403 Forbidden" "Invalid renderer source identity" ;;
	esac
	for identity_part in "$identity_device" "$identity_inode" "$identity_size"; do
		case "$identity_part" in
			''|*[!0-9]*)
				http_err "403 Forbidden" "Invalid renderer source identity"
				;;
		esac
		[ "${#identity_part}" -le 20 ] ||
			http_err "403 Forbidden" "Invalid renderer source identity"
	done
	if [ "${#identity_size}" -gt "$MAX_RANGE_DIGITS" ] ||
	   [ "$identity_size" -le 0 ]; then
		http_err "403 Forbidden" "Invalid renderer source identity"
	fi
	exec 3< "$source_fd" ||
		http_err "403 Forbidden" "Renderer source is no longer available"
	[ "$(stat -L -c '%F' -- /proc/self/fd/3 2>/dev/null)" = \
		"regular file" ] || {
			exec 3<&-
			http_err "403 Forbidden" "Opened renderer source is not a regular file"
		}
	opened_identity="$(
		stat -L -c '%d:%i:%s' -- /proc/self/fd/3 2>/dev/null
	)" || {
		exec 3<&-
		http_err "403 Forbidden" "Cannot validate opened renderer source"
	}
	[ "$opened_identity" = "$source_identity" ] || {
		exec 3<&-
		http_err "403 Forbidden" "Renderer source changed during validation"
	}
	source_info_after="$(
		"$RENDERER_HELPER" source-info "$renderer" "$audio" \
			3<&- 2>/dev/null
	)" || {
		exec 3<&-
		http_err "403 Forbidden" "Renderer session ended during validation"
	}
	[ "$source_info_after" = "$source_info" ] || {
		exec 3<&-
		http_err "403 Forbidden" "Renderer source changed during validation"
	}
	renderer_bound=1
fi

if [ "$renderer_bound" -eq 0 ]; then
	opened="$(readlink -f -- /proc/self/fd/3 2>/dev/null)" || {
		exec 3<&-
		http_err "403 Forbidden" "Cannot validate opened media file"
	}
	if [ "$opened" != "$canonical" ] ||
	   ! path_is_within_root "$root" "$opened"; then
		exec 3<&-
		http_err "403 Forbidden" "Media file changed during validation"
	fi
fi

metadata="$(stat -L -c '%F:%s' -- /proc/self/fd/3 2>/dev/null)" || {
	exec 3<&-
	http_err "500 Internal Server Error" "Cannot stat media file"
}
case "$metadata" in
	"regular file:"*) size="${metadata#regular file:}" ;;
	*)
		exec 3<&-
		http_err "403 Forbidden" "Opened media is not a regular file"
		;;
esac
case "$size" in
	''|*[!0-9]*)
		exec 3<&-
		http_err "500 Internal Server Error" "Invalid media size"
		;;
esac
if [ "$renderer_bound" -eq 1 ] && [ "$size" != "$identity_size" ]; then
	exec 3<&-
	http_err "403 Forbidden" "Renderer source size changed during validation"
fi
[ "${#size}" -le "$MAX_RANGE_DIGITS" ] || {
	exec 3<&-
	http_err "500 Internal Server Error" "Media file is too large"
}
[ "$size" -gt 0 ] || {
	exec 3<&-
	http_err "404 Not Found" "Empty media file"
}

parse_range "${HTTP_RANGE:-}" "$size" || {
	exec 3<&-
	range_err "$size"
}

start="$RANGE_START"
end="$RANGE_END"
status="$RANGE_STATUS"
length=$((end - start + 1))
mime="$(mime_for "$canonical")"

# Probe dd byte flags before headers; never fall back after response bytes have
# already been emitted.
DD_BYTE_FLAGS=0
if [ "$REQUEST_METHOD" = "GET" ] && [ "$status" = "206 Partial Content" ] &&
   dd bs=1 iflag=skip_bytes,count_bytes skip=0 count=0 </dev/null >/dev/null 2>&1; then
	DD_BYTE_FLAGS=1
fi

printf 'Status: %s\r\n' "$status"
printf 'Content-Type: %s\r\n' "$mime"
printf 'Accept-Ranges: bytes\r\n'
printf 'Content-Length: %s\r\n' "$length"
if [ "$status" = "206 Partial Content" ]; then
	printf 'Content-Range: bytes %s-%s/%s\r\n' "$start" "$end" "$size"
fi
if [ "$renderer_bound" -eq 1 ]; then
	printf 'Cache-Control: no-store\r\n'
else
	printf 'Cache-Control: private, max-age=300\r\n'
fi
printf 'X-Content-Type-Options: nosniff\r\n'
printf 'Referrer-Policy: no-referrer\r\n'
printf '\r\n'

if [ "$REQUEST_METHOD" = "HEAD" ]; then
	exec 3<&-
	exit 0
fi

if [ "$start" -eq 0 ] && [ "$length" -eq "$size" ]; then
	# Keep the body bounded by the advertised Content-Length if a file grows
	# after stat(1) but before the response has finished.
	head -c "$length" <&3 2>/dev/null
else
	send_range "$start" "$length"
fi

exec 3<&-
exit 0
